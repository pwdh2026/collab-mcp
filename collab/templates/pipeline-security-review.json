{
  "name": "pipeline-security-review",
  "description": "安全审查流水线（借鉴 codex-security）：lint → security-review（复核闸门）",
  "required_params": ["target", "project_path"],
  "default_params": {},
  "pipeline": [
    {
      "name": "lint",
      "template": "run-tests",
      "params": {"project_path": "{project_path}"},
      "depends_on": [],
      "claim_timeout_minutes": 20
    },
    {
      "name": "security-review",
      "template": "security-review",
      "params": {"target": "{target}"},
      "depends_on": ["lint"],
      "claim_timeout_minutes": 60
    }
  ]
}
