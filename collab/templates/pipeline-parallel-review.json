{
  "name": "pipeline-parallel-review",
  "description": "并行审查流水线：lint → [test-unit, test-integration]（并行扇出）→ review（复核闸门，fan-in）",
  "required_params": ["target", "project_path"],
  "default_params": {},
  "pipeline": [
    {
      "name": "lint",
      "template": "run-tests",
      "params": {"project_path": "{project_path}"},
      "depends_on": [],
      "claim_timeout_minutes": 15
    },
    {
      "name": "test-unit",
      "template": "run-tests",
      "params": {"project_path": "{project_path}"},
      "depends_on": ["lint"],
      "claim_timeout_minutes": 20,
      "max_retries": 2
    },
    {
      "name": "test-integration",
      "template": "run-tests",
      "params": {"project_path": "{project_path}"},
      "depends_on": ["lint"],
      "claim_timeout_minutes": 30
    },
    {
      "name": "review",
      "template": "code-review",
      "params": {"target": "{target}"},
      "depends_on": ["test-unit", "test-integration"],
      "claim_timeout_minutes": 45
    }
  ]
}
